# Copie este arquivo para .streamlit/secrets.toml e preencha a chave.
# O secrets.toml está no .gitignore: a chave nunca vai para o Git.
# No Streamlit Community Cloud, cadastre os mesmos nomes em Settings > Secrets.

ELOAGENTS_API_KEY = "cole-sua-chave-aqui"

